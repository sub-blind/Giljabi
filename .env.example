# 공공데이터포털의 국문 관광정보 서비스 인증키
TOUR_API_SERVICE_KEY=

# 관광 API 서버 주소
TOUR_API_KOR_SERVICE_BASE=https://apis.data.go.kr/B551011/KorService2

# 관광 API 필수 앱 정보와 이 프로세스의 일일 조회 상한
TOUR_API_MOBILE_APP=StoryRoute
TOUR_API_MOBILE_OS=WEB
TOUR_API_DAILY_LIMIT=900

# 선택 사항: 관광사진 정보. 국문 관광정보와 인증 설정을 분리
PHOTO_API_BASE_URL=https://apis.data.go.kr/B551011/PhotoGalleryService1
PHOTO_API_SERVICE_KEY=

# 선택 사항: 오디오 가이드정보
AUDIO_API_BASE_URL=https://apis.data.go.kr/B551011/Odii
AUDIO_API_SERVICE_KEY=

# 선택 사항: 연관 관광지 정보
RELATED_API_BASE_URL=https://apis.data.go.kr/B551011/TarRlteTarService1
RELATED_API_SERVICE_KEY=
RELATED_API_BASE_MONTH=202504

# 선택 사항: 무장애 여행정보. 장소 상세에서 방문 편의정보 확인
ACCESS_API_BASE_URL=https://apis.data.go.kr/B551011/KorWithService2
ACCESS_API_SERVICE_KEY=

# 선택 사항: 두 값을 모두 설정하면 AI 해석·근거 선택 사용
# 해당 API 계정에서 구조화 출력을 지원하는 모델을 지정
OPENAI_API_KEY=
OPENAI_MODEL=

# 선택 사항: 서버 전용 PostgreSQL 연결. 프런트 환경파일에 넣지 않는다.
# 로컬 Compose 설정과 DATABASE_URL의 사용자·비밀번호·DB 이름·포트를 맞춘다.
STORYROUTE_DB_NAME=storyroute
STORYROUTE_DB_USER=storyroute
STORYROUTE_DB_PASSWORD=
STORYROUTE_DB_PORT=55432
# 예시 형식: postgresql+psycopg://사용자:URL인코딩한비밀번호@127.0.0.1:55432/storyroute
DATABASE_URL=
DATABASE_POOL_SIZE=2
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# 로컬 개발 프런트 주소
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 카카오 로그인·자동차 길찾기 서버 키. 길찾기는 해당 앱의 이용 권한 필요
KAKAO_REST_API_KEY=
ROUTE_API_DAILY_LIMIT=100
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/kakao/callback
KAKAO_LOGOUT_REDIRECT_URI=http://127.0.0.1:3000

# 기존 인증 기능의 서명·세션 설정
AUTH_JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
AUTH_FRONTEND_SUCCESS_URL=http://127.0.0.1:3000/auth/callback?status=success
AUTH_FRONTEND_FAILURE_URL=http://127.0.0.1:3000/auth/callback?status=error
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
AUTH_SECURE_COOKIES=false
