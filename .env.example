# TourAPI service key
TOUR_API_SERVICE_KEY=

# TourAPI KorService2 base URL
TOUR_API_KOR_SERVICE_BASE=http://apis.data.go.kr/B551011/KorService2

# TourAPI required params
TOUR_API_MOBILE_APP=Tourism
TOUR_API_MOBILE_OS=ETC

# Frontend origins for local development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Kakao Login
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/kakao/callback
KAKAO_LOGOUT_REDIRECT_URI=http://127.0.0.1:3000

# Auth / JWT
AUTH_JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
AUTH_FRONTEND_SUCCESS_URL=http://127.0.0.1:3000/auth/callback?status=success
AUTH_FRONTEND_FAILURE_URL=http://127.0.0.1:3000/auth/callback?status=error
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
AUTH_SECURE_COOKIES=false
